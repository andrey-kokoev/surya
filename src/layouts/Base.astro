---
interface Props {
  title: string;
  description: string;
  path: string;
}

const { title, description, path } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={`https://surya.narada.systems${path}`} />
    <style is:global>
      :root {
        --bg: #0b0d10;
        --bg-raised: #12161b;
        --fg: #e8e6e1;
        --fg-dim: #9aa3ad;
        --accent: #f0a832;
        --accent-dim: #8a6420;
        --rule: #232a32;
        --kill: #7d8590;
        --space-1: 0.25rem;
        --space-2: 0.5rem;
        --space-3: 0.75rem;
        --space-4: 1rem;
        --space-5: 1.5rem;
        --space-6: 2rem;
        --space-8: 3rem;
        --space-10: 4rem;
        --text-sm: 0.875rem;
        --text-base: 1rem;
        --text-lg: 1.25rem;
        --text-xl: 1.6rem;
        --text-2xl: 2.1rem;
        --text-3xl: 2.8rem;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--fg);
        font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
        font-size: var(--text-base);
        line-height: 1.65;
      }
      .wrap { max-width: 62rem; margin: 0 auto; padding: 0 var(--space-5); }
      a { color: var(--accent); text-decoration: none; }
      a:hover { text-decoration: underline; }
      code {
        font-family: ui-monospace, "Cascadia Code", Consolas, monospace;
        font-size: 0.92em;
        background: var(--bg-raised);
        padding: 0.1em 0.35em;
        border-radius: 4px;
      }
      header.site {
        border-bottom: 1px solid var(--rule);
        padding: var(--space-4) 0;
      }
      header.site .wrap {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: var(--space-4);
      }
      .wordmark {
        font-weight: 800;
        letter-spacing: -0.02em;
        font-size: var(--text-lg);
        color: var(--fg);
      }
      .wordmark span { color: var(--accent); }
      nav.site-nav { display: flex; gap: var(--space-5); font-size: var(--text-sm); }
      nav.site-nav a { color: var(--fg-dim); }
      nav.site-nav a:hover { color: var(--accent); text-decoration: none; }
      footer.site {
        border-top: 1px solid var(--rule);
        margin-top: var(--space-10);
        padding: var(--space-5) 0 var(--space-8);
        color: var(--fg-dim);
        font-size: var(--text-sm);
      }
    </style>
  </head>
  <body>
    <header class="site">
      <div class="wrap">
        <a class="wordmark" href="/">surya<span>.narada.systems</span></a>
        <nav class="site-nav">
          <a href="/directions/">directions</a>
          <a href="/#closed">closed</a>
          <a href="https://space.narada.systems" rel="noopener">space ↗</a>
          <a href="https://narada.systems" rel="noopener">narada ↗</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site">
      <div class="wrap">
        Surya is a Narada family research program. Every claim on this site
        carries its confidence class; closed directions stay published with
        their reasons. Marici is the light before the source. Surya is the
        source.
      </div>
    </footer>
  </body>
</html>
