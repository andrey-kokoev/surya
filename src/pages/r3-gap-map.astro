  ["GaAs, protection layers", "“Repeated use,” no repolish needed (Lee 2012); “indefinite” claimed, count not stated (Lee 2014); direct reuse without post-processing (Cheng/IBM 2013)", "count not published"],
  ["GaAs, IMM cells (MicroLink)", "“Multiple substrate reuses” demonstrated (Adams 2013, IEEE J. PV)", "count paywalled/unstated"],
  ["GaAs, water-soluble sacrificial", "“Multiple reuses,” no CMP, no degradation (Sharma 2022)", "count not extractable"],
  ["Ge, porous-Ge PEELER", "1 reuse demonstrated; RMS roughness 20.1→1.3 nm after wet reconditioning; ~30 projected (Paupy 2023)", "projection, not demonstration"],
  ["Ge, controlled spalling", "49 cells on spalled 50 mm Ge, best 23.4%, no CMP (Mangum 2022)", "spalling, not classic ELO"],
];

const players = [
