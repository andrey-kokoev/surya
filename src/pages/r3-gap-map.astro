  ["Rocket Lab / SolAero", "IMM-α 32.0% min avg BOL in production; IMM-β ~33.3% BOL, 87% power remaining at 10¹⁵ e/cm², listed as space-qualified 5J product", "Volume production of substrate-removed IMM cells; $80M acquisition (2022); $23.9M CHIPS award (2024)", "Removes the substrate but claims no reuse and no ELO — liberation from substrate mass, not from substrate consumption"],
  ["AZUR SPACE", "Ge-substrate 3G30/4G32 lines; no ELO product or position found", "ESA EUOG study: recycles Ge from backgrinding waste, >90% recovery target (~80% reported implemented 2021)", "Answers the chokepoint with recycling, not lift-off"],
  ["Fraunhofer ISE / tf2", "IMM4J thin-film: 13 µm stack, 140 g/m², >3000 W/kg, 30.9% AM0 BOL (peer-reviewed); EpiWafer reusable-template program with licensable patents", "Laboratory", "No published ISE ELO cell or reuse-cycle data; handling cracks documented in unsupported films"],
  ["NREL", "IMM architecture origin (40.8% at 326 suns, 2008); TEAs anchoring the cost picture; spalling and Ge-on-nothing demos", "Research + tech transfer (exclusive IMM license to MicroLink)", "GON route at 14.4% — lab-to-industry gap runs in industry's favor here"],
  ["Umicore / ESA-ELLA", "200 mm engineered Ge substrates (Ge-on-nothing, porous Ge); wafer reused 2×; 3J cells on 7 µm Ge foil ≈ controls", "Government-contracted feasibility", "Lab scale; no production intent stated"],
];

const sources = [
