  ["Ramu et al., Sol. Energy Mater. Sol. Cells (2022)", "15 mm/h via InGaAs internal stressor + PMMA surface stressor", "https://www.sciencedirect.com/science/article/pii/S0927024822003993"],
  ["van Niftrik et al., J. Electrochem. Soc. (2007)", "Diffusion–reaction model bounding lateral etch rate", "https://doi.org/10.1149/1.2779968"],
  ["van Geelen et al., Mater. Sci. Eng. B (1997)", "4 GaAs reuses, no materials degradation", "https://doi.org/10.1016/S0921-5107(96)02029-6"],
  ["Bauhuis et al., Prog. Photovolt. (2010)", "Wafer reuse for repeated III-V growth; ~10 µm loss per cycle", "https://doi.org/10.1002/pip.930"],
  ["Adams et al. (MicroLink), IEEE J. Photovoltaics (2013)", "Multiple substrate reuses for IMM cells", "https://doi.org/10.1109/JPHOTOV.2013.2245722"],
  ["Cheng et al. (IBM), Nat. Commun. (2013)", "Direct substrate reuse without post-processing", "https://doi.org/10.1038/ncomms2583"],
