  ["Horowitz et al. (NREL, 2018)", "III-V cost reduction roadmap; Ge substrate the largest cost", "https://doi.org/10.2172/1484349"],
  ["Mangum et al. (NREL/Mines), Adv. Energy Mater. (2022)", "Spalled Ge without polishing; ELO the only commercially deployed reuse tech", "https://doi.org/10.1002/aenm.202201332"],
  ["Paupy et al., Nanoscale Adv. (2023)", "PEELER porous-Ge: 1 reuse demonstrated, ~30 projected", "https://doi.org/10.1039/D3NA00053B"],
