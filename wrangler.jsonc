{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "surya",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist/client"
  },
  "routes": [
    { "pattern": "surya.narada.systems", "custom_domain": true }
  ]
}
