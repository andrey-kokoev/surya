      "evidence_class": "evidence-backed",
      "kind": "claim",
      "local_ref": "c2",
      "op": "entity.declare",
      "entity_id": "surya-claim-r7-solar-dynamic-2026-08",
      "title": "Solar-dynamic Stirling/Brayton: 29% cycle and 17% orbital efficiency measured end-to-end; the only engineered system point is ~3.4 W/kg (Freedom 25 kWe module); all higher figures (10-40 near-term, 120-700 W/kg far-term) are unbuilt study projections; no flight program since 1991"
    },
    {
      "evidence_class": "evidence-backed",
      "kind": "claim",
      "local_ref": "c3",
      "op": "entity.declare",
      "entity_id": "surya-claim-r7-thermionics-2026-08",
      "title": "Solar thermionics: converters demonstrated 6-13% (best ~16% at 2200 K); the only system-level study is a 1978 NASA design at ~14 W/kg dominated by concentrator mass; >30% efficiency and 100 W/cm2 remain theoretical; the dedicated solar-thermionic program was discontinued in the 1970s as uncompetitive with PV"
    },
    {
      "evidence_class": "evidence-backed",
      "kind": "claim",
      "local_ref": "c4",
      "op": "entity.declare",
      "entity_id": "surya-claim-r7-tpv-2026-08",
      "title": "Solar TPV: cell physics reached 41.1% at 2400 C (2022) and 44% at 1435 C (2024), but measured complete solar-TPV systems are 0.8-3.2% solar-to-electric; all space TPV heritage is nuclear-heated, 100 We class, 6-8 W/kg; no orbital solar-TPV system-level W/kg estimate exists in the literature"
    },
    {
      "evidence_class": "evidence-backed",
      "kind": "claim",
      "local_ref": "c5",
      "op": "entity.declare",
      "entity_id": "surya-claim-r7-pv-baseline-2026-08",
      "title": "PV baseline (Aug 2026): production III-V cells 30.7-34% AM0; arrays 50 W/kg rigid and 100-200 W/kg flexible flown (UltraFlex 175 W/kg); cells cost hundreds of $/W, arrays ~$1,650/W on the last public dataset (2002); Si entrants target $20/W; thin-film cells exceed 1 kW/kg at cell level, TRL 3-4"
    },
    {
      "evidence_class": "evidence-backed",
      "kind": "claim",
      "local_ref": "c1",
      "op": "entity.declare",
      "entity_id": "surya-claim-r7-closing-2026-08",
      "title": "R7 closing argument (Aug 2026): on measured system-level numbers, no non-photovoltaic solar technology beats PV on specific power, cost, or readiness; only unbuilt study projections compete; non-PV solar is retired from future trade studies"
    },
