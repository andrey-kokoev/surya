    {
      "entity_id": "surya-claim-r5-space-deposition-precedent",
      "kind": "claim",
      "op": "entity.declare",
      "title": "Wake Shield Facility remains the only in-space semiconductor deposition precedent: MBE/CBE GaAs-family film growth with dramatically reduced contamination; never a complete cell, program ended with Shuttle era"
    },
    {
      "entity_id": "surya-claim-r5-cell-on-membrane-flown",
      "kind": "claim",
      "op": "entity.declare",
      "title": "A complete ultralight cell has been fabricated on Earth and flown on a membrane: IKAROS a-Si on 7.5-micron polyimide, ~500 W"
    },
    {
      "entity_id": "surya-claim-r5-ao-limits-leo",
      "kind": "claim",
      "op": "entity.declare",
      "title": "Atomic oxygen erosion (Kapton yield ~3.0e-24 cm3/atom) makes unprotected micron-scale polymer membranes short-lived in LEO ram, pushing in-space manufacturing to GEO/high orbits or requiring protective coatings"
    },
    {
      "entity_id": "surya-claim-r5-rate-quality-tension",
      "kind": "claim",
      "op": "entity.declare",
      "title": "Record flexible thin-film cells (21.4% CIGS on polymer) are produced at low deposition rates (~0.1-0.5 nm/s); the R5 in-space wedge must accept relaxed quality or solve rate-quality co-optimization"
    },
    {
      "entity_id": "surya-claim-r5-feedstock-leverage",
      "kind": "claim",
      "op": "entity.declare",
      "title": "Mass leverage for on-orbit fabrication is ~100x: feedstock at 30 W/g vs state-of-art arrays at 40-225 W/kg"
    },
    {
      "entity_id": "surya-claim-r5-isam-weak",
      "kind": "claim",
      "op": "entity.declare",
      "title": "ISAM is a weak incumbent for in-space PV manufacturing: OSAM-1 cancelled, OSAM-2 concluded without flight; in-space manufacturing heritage is confined to polymer printing, ZBLAN fiber draws, and a ceramic demo"
    },
    {
      "entity_id": "surya-claim-r5-perovskite-space-resilient",
      "kind": "claim",
      "op": "entity.declare",
      "title": "Perovskite thin films show strong space-environment resilience (10-month ISS exposure stable; rad-stable quasi-2D ultrathin flexible cells), strengthening the coater-on-membrane route"
    },
    {
      "entity_id": "surya-claim-r5-economics-bar",
      "kind": "claim",
      "op": "entity.declare",
      "title": "The economic bar for R5 is high and regime-dependent: launch $3,000-7,000/kg with Starship threatening <$1,000/kg; incumbent space cells at $50-640/W while Starlink COTS silicon at $0.20-0.50/W under extreme cadence"
    },
