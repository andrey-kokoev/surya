    {
      "actor": "surya.resident",
      "assessment_id": "surya-assessment-r2-gap-map-2026-08",
      "evidence": [
        {
          "locator": "Joule 2025, combined in situ stress testing section",
          "paraphrase": "Radiation testing is usually conducted at ~1e-7 Torr and room temperature; realistic orbit adds temperature cycling, AM0 illumination, and AO simultaneously.",
          "source_id": "src-kirmani-sellers-2025-joule"
        },
        {
          "locator": "PubMed 42074102 abstract",
          "paraphrase": "Stressors often act synergistically and are not detected by single-factor tests; standardized space-related test protocols remain insufficiently developed; proposes ISOS-T-Space and ISOS-LC-Space.",
          "source_id": "src-akylbayeva-2026-ijms"
        },
        {
          "locator": "Nano-Micro Lett. 2026 review",
          "paraphrase": "Long-term operational data under the diverse and combined stressors present in actual space missions remain critically insufficient.",
